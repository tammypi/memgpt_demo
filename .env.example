# 对话模型（OpenAI Chat Completions 兼容接口）
LLM_API_URL=https://api.moonshot.cn/v1/chat/completions
LLM_API_KEY=请填写你的密钥
LLM_MODEL=moonshot-v1-auto

# 浏览器前端地址，多个地址使用英文逗号分隔
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 本地数字人：CosyVoice 2 使用 CPU，MuseTalk 1.5 使用 GPU FP16
COSYVOICE_ROOT=models/CosyVoice
COSYVOICE_MODEL=models/CosyVoice/pretrained_models/CosyVoice2-0.5B
COSYVOICE_PYTHON=.venvs/cosyvoice/bin/python
MUSETALK_ROOT=models/MuseTalk
MUSETALK_MODEL=models/MuseTalk/models/musetalkV15
MUSETALK_PYTHON=.venvs/musetalk/bin/python
MUSETALK_BATCH_SIZE=2
AVATAR_SOURCE_VIDEO=frontend/assets/doctor-speaking-long-01.mp4
AVATAR_TTS_SPEAKER=中文女
AVATAR_TTS_PROMPT_WAV=models/CosyVoice/asset/zero_shot_prompt.wav
AVATAR_TTS_PROMPT_TEXT=希望你以后能够做的比我还好呦。
AVATAR_SEGMENT_MAX_CHARS=70

# 等待阶段使用的本地或远程循环视频
AVATAR_IDLE_VIDEO=assets/doctor-idle.mp4
AVATAR_LISTENING_VIDEO=assets/doctor-listening.mp4
AVATAR_THINKING_VIDEO=assets/doctor-thinking.mp4
